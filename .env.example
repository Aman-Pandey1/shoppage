# --- Server ---
PORT=4000
FRONTEND_URL=http://localhost:5173
USE_MOCK_DATA=true

# --- Mongo (optional) ---
# MONGO_URI=mongodb+srv://user:pass@cluster/db

# --- Admin (optional) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd

# --- Order notify (optional) ---
# If set, server will POST order details after payment/creation
# Defaults to Blueboxx backend notify endpoint
# ORDER_NOTIFY_URL=https://blueboxx-backend.onrender.com/api/order/notify

# --- SMTP (Hostinger example) ---
# For Hostinger business mailboxes, use these values:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465             # SSL (recommended) or 587 for STARTTLS
# SMTP_USER=no-reply@blueboxx.ca
# SMTP_PASS=<your-mailbox-password>
# SMTP_FROM=orders@blueboxx.ca

# --- Test email helper ---
# TEST_EMAIL_TO=you@yourdomain.com
