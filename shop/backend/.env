PORT=4000
USE_MOCK_DATA=false
# Replace with your MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/shopdb?retryWrites=true&w=majority&appName=app

# Auth
JWT_SECRET=change_me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Stripe (TEST mode)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_sig_secret
STRIPE_CURRENCY=usd

# Frontend URL for Stripe redirect
FRONTEND_URL=http://localhost:5173

# Uploads directory
UPLOAD_DIR=%s
